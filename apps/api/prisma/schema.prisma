// Schema da Fase 0 — Fundacao.
// Apenas as entidades necessarias para autenticacao, perfis, filas basicas e White Label.
// Conversa / Mensagem / Contato entram na Fase 1 (MVP de Atendimento).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Endpoint pooled (pgbouncer) para a aplicacao.
  url       = env("DATABASE_URL")
  // Endpoint direto: o Prisma Migrate precisa de conexao sem pooler.
  // Em ambientes sem pooler, aponte as duas variaveis para a mesma URL.
  directUrl = env("DIRECT_URL")
}

/// Perfis de acesso (Fase 0 do escopo).
enum Role {
  ADMIN
  SUPERVISOR
  AGENTE
}

/// Status de presenca do agente, exibido no cabecalho.
enum AgentStatus {
  OFFLINE
  DISPONIVEL
  EM_ATENDIMENTO
  PAUSA
}

model User {
  id           String      @id @default(uuid())
  nome         String
  email        String      @unique
  senhaHash    String      @map("senha_hash")
  perfil       Role        @default(AGENTE)
  status       AgentStatus @default(OFFLINE)
  ativo        Boolean     @default(true)
  ultimoLogin  DateTime?   @map("ultimo_login")
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  filas             QueueAgent[]
  conversas         Conversation[]
  mensagensEnviadas Message[]
  leads             Lead[]
  oportunidades     Opportunity[]
  protocolos        Ticket[]
  escalas           WorkShift[]
  presenca          PresenceLog[]
  campanhas         Campaign[]
  comentarios       TicketComment[]
  anexos            TicketAttachment[]
  agendamentos      TicketSchedule[]
  registrosLgpd     LgpdLog[]
  chamadas          Call[]
  atividades        Activity[]            @relation("AtividadeResponsavel")
  atividadesCriadas Activity[]            @relation("AtividadeAutor")
  mudancasEstagio   OpportunityStageLog[]
  tokensIntegracao  IntegrationToken[]

  @@index([perfil])
  @@map("usuarios")
}

/// Canais de atendimento previstos. Fase 1 comeca por WEBCHAT.
enum Channel {
  WEBCHAT
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  EMAIL
  VOZ
}

model Queue {
  id           String   @id @default(uuid())
  nome         String   @unique
  descricao    String?
  canalPadrao  Channel  @default(WEBCHAT) @map("canal_padrao")
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  agentes    QueueAgent[]
  conversas  Conversation[]
  protocolos Ticket[]
  canais     ChannelConfig[]
  campanhas  Campaign[]
  botPassos  BotStep[]
  chamadas   Call[]
  vozConfig  VoiceConfig[]

  @@map("filas")
}

/// Vinculo agente <-> fila.
model QueueAgent {
  id        String   @id @default(uuid())
  filaId    String   @map("fila_id")
  usuarioId String   @map("usuario_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  fila    Queue @relation(fields: [filaId], references: [id], onDelete: Cascade)
  usuario User  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([filaId, usuarioId])
  @@index([usuarioId])
  @@map("filas_agentes")
}

/// White Label — registro unico (id fixo "default") com a identidade visual da instancia.
model Branding {
  id            String   @id @default("default")
  appName       String   @default("Plataforma de Atendimento") @map("app_name")
  logoUrl       String?  @map("logo_url")
  corPrimaria   String   @default("#2563eb") @map("cor_primaria")
  corSecundaria String   @default("#0f172a") @map("cor_secundaria")
  corDestaque   String   @default("#16a34a") @map("cor_destaque")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@map("branding")
}

// ---------------------------------------------------------------------------
// Fase 1 — MVP de Atendimento
// ---------------------------------------------------------------------------

/// Abas do painel de atendimento.
enum ConversationStatus {
  EM_ESPERA
  ATRIBUIDO
  EM_ATENDIMENTO
  FINALIZADO
}

/// Quem escreveu a mensagem. SISTEMA registra eventos (atribuicao, transferencia, fim).
enum MessageAuthor {
  CLIENTE
  AGENTE
  SISTEMA
  BOT
}

enum AttachmentType {
  TEXTO
  IMAGEM
  AUDIO
  VIDEO
  ARQUIVO
}

/// Contato/cliente final. Base do CRM (expandido na Fase 2 com Conta, Lead e Oportunidade).
model Contact {
  id              String    @id @default(uuid())
  nome            String
  telefone        String?
  email           String?
  canalOrigem     Channel   @default(WEBCHAT) @map("canal_origem")
  tags            String[]  @default([])
  observacoes     String?
  /// Momento em que o titular aceitou o aviso de privacidade (LGPD art. 8).
  consentimentoEm DateTime? @map("consentimento_em")
  /// Preenchido quando os dados pessoais foram substituidos por placeholders.
  anonimizadoEm   DateTime? @map("anonimizado_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  contaId String? @map("conta_id")

  conta         Account?       @relation(fields: [contaId], references: [id], onDelete: SetNull)
  conversas     Conversation[]
  leads         Lead[]
  protocolos    Ticket[]
  itensCampanha CampaignItem[]
  chamadas      Call[]
  atividades    Activity[]

  @@index([email])
  @@index([telefone])
  @@map("contatos")
}

model Conversation {
  id        String             @id @default(uuid())
  canal     Channel            @default(WEBCHAT)
  status    ConversationStatus @default(EM_ESPERA)
  contatoId String             @map("contato_id")
  filaId    String?            @map("fila_id")
  agenteId  String?            @map("agente_id")
  assunto   String?

  criadoEm         DateTime  @default(now()) @map("criado_em")
  atribuidoEm      DateTime? @map("atribuido_em")
  finalizadoEm     DateTime? @map("finalizado_em")
  ultimaMensagemEm DateTime  @default(now()) @map("ultima_mensagem_em")
  naoLidas         Int       @default(0) @map("nao_lidas")
  /// Identificador do interlocutor no canal externo (wa_id, PSID, IGSID).
  enderecoExterno  String?   @map("endereco_externo")

  contato    Contact   @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  fila       Queue?    @relation(fields: [filaId], references: [id], onDelete: SetNull)
  agente     User?     @relation(fields: [agenteId], references: [id], onDelete: SetNull)
  mensagens  Message[]
  protocolos Ticket[]
  pesquisa   Survey?
  chamadas   Call[]

  @@index([status, ultimaMensagemEm])
  @@index([agenteId, status])
  @@index([filaId, status])
  @@map("conversas")
}

model Message {
  id         String         @id @default(uuid())
  conversaId String         @map("conversa_id")
  autor      MessageAuthor
  /// Preenchido quando autor = AGENTE.
  autorId    String?        @map("autor_id")
  conteudo   String
  tipoAnexo  AttachmentType @default(TEXTO) @map("tipo_anexo")
  anexoUrl   String?        @map("anexo_url")
  /// Id da mensagem no provedor externo. Unico: o webhook da Meta reentrega.
  idExterno  String?        @unique @map("id_externo")
  criadoEm   DateTime       @default(now()) @map("criado_em")

  conversa     Conversation @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autorUsuario User?        @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([conversaId, criadoEm])
  @@map("mensagens")
}

// ---------------------------------------------------------------------------
// Fase 2 — CRM completo
// ---------------------------------------------------------------------------

/// Fases do funil de leads. GANHO/PERDIDO sao terminais.
enum LeadFase {
  NOVO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

enum LeadTipo {
  INBOUND
  OUTBOUND
  INDICACAO
  PARCEIRO
}

enum MotivoPerda {
  PRECO
  SEM_INTERESSE
  CONCORRENTE
  SEM_BUDGET
  SEM_RESPOSTA
  OUTRO
}

enum OportunidadeStatus {
  ABERTA
  GANHA
  PERDIDA
}

/// Conta/Empresa: agrupa contatos e oportunidades.
model Account {
  id           String   @id @default(uuid())
  nome         String
  cnpj         String?  @unique
  segmento     String?
  site         String?
  telefone     String?
  email        String?
  observacoes  String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  contatos      Contact[]
  leads         Lead[]
  oportunidades Opportunity[]
  protocolos    Ticket[]
  atividades    Activity[]

  @@index([nome])
  @@map("contas")
}

model Lead {
  id            String       @id @default(uuid())
  contatoId     String       @map("contato_id")
  contaId       String?      @map("conta_id")
  fase          LeadFase     @default(NOVO)
  tipo          LeadTipo     @default(INBOUND)
  responsavelId String?      @map("responsavel_id")
  prazo         DateTime?
  canalOrigem   Channel      @default(WEBCHAT) @map("canal_origem")
  motivoPerda   MotivoPerda? @map("motivo_perda")
  valorEstimado Decimal?     @map("valor_estimado") @db.Decimal(14, 2)
  observacoes   String?
  criadoEm      DateTime     @default(now()) @map("criado_em")
  atualizadoEm  DateTime     @updatedAt @map("atualizado_em")
  fechadoEm     DateTime?    @map("fechado_em")

  contato     Contact  @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  conta       Account? @relation(fields: [contaId], references: [id], onDelete: SetNull)
  responsavel User?    @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([fase, atualizadoEm])
  @@index([responsavelId, fase])
  @@map("leads")
}

/// Funil customizavel de oportunidades.
model Funnel {
  id       String   @id @default(uuid())
  nome     String   @unique
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  estagios      FunnelStage[]
  oportunidades Opportunity[]

  @@map("funis")
}

model FunnelStage {
  id            String @id @default(uuid())
  funilId       String @map("funil_id")
  nome          String
  ordem         Int
  /// Probabilidade de fechamento no estagio (0-100), usada em previsao.
  probabilidade Int    @default(0)

  funil         Funnel                @relation(fields: [funilId], references: [id], onDelete: Cascade)
  oportunidades Opportunity[]
  saidas        OpportunityStageLog[] @relation("EstagioSaida")
  entradas      OpportunityStageLog[] @relation("EstagioEntrada")

  @@unique([funilId, ordem])
  @@map("funil_estagios")
}

model Opportunity {
  id                 String             @id @default(uuid())
  titulo             String
  contaId            String             @map("conta_id")
  funilId            String             @map("funil_id")
  estagioId          String             @map("estagio_id")
  valor              Decimal            @default(0) @db.Decimal(14, 2)
  responsavelId      String?            @map("responsavel_id")
  status             OportunidadeStatus @default(ABERTA)
  motivoPerda        MotivoPerda?       @map("motivo_perda")
  previsaoFechamento DateTime?          @map("previsao_fechamento")
  criadoEm           DateTime           @default(now()) @map("criado_em")
  atualizadoEm       DateTime           @updatedAt @map("atualizado_em")
  fechadoEm          DateTime?          @map("fechado_em")
  /// Desde quando esta no estagio atual. Denormalizado de proposito: o cartao do
  /// kanban mostra "dias na etapa" em toda renderizacao, e derivar isso do
  /// historico custaria uma agregacao por cartao.
  estagioDesde       DateTime           @default(now()) @map("estagio_desde")

  conta            Account               @relation(fields: [contaId], references: [id], onDelete: Cascade)
  funil            Funnel                @relation(fields: [funilId], references: [id])
  estagio          FunnelStage           @relation(fields: [estagioId], references: [id])
  responsavel      User?                 @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  itens            OpportunityItem[]
  atividades       Activity[]
  historicoEstagio OpportunityStageLog[]

  @@index([status, atualizadoEm])
  @@index([funilId, estagioId])
  @@map("oportunidades")
}

/// Tipos de atividade comercial. Sao os mesmos que os CRMs avaliados usam para
/// medir produtividade por vendedor (ver ANALISE-CRM.md): sem tipo na atividade,
/// o relatorio de "atividades feitas / agendadas por tipo" nao existe.
enum TipoAtividade {
  NOTA
  LIGACAO
  WHATSAPP
  EMAIL
  REUNIAO
  VISITA
  PROPOSTA
}

/// Atividade comercial: ou um registro do que aconteceu, ou uma tarefa com prazo.
/// A diferenca e o campo `prazo` — nulo significa "so registrei", preenchido
/// significa "tenho que fazer". Um mesmo modelo para os dois porque a linha do
/// tempo do cliente mostra os dois lado a lado, na mesma ordem cronologica.
model Activity {
  id            String        @id @default(uuid())
  tipo          TipoAtividade
  titulo        String
  descricao     String?
  prazo         DateTime?
  concluidoEm   DateTime?     @map("concluido_em")
  responsavelId String?       @map("responsavel_id")
  criadoPorId   String?       @map("criado_por_id")

  /// Ao menos um vinculo e obrigatorio; validado na camada de servico, nao no
  /// banco, porque Prisma nao expressa "um destes quatro nao nulo".
  contatoId      String? @map("contato_id")
  contaId        String? @map("conta_id")
  oportunidadeId String? @map("oportunidade_id")
  protocoloId    String? @map("protocolo_id")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  responsavel  User?        @relation("AtividadeResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoPor    User?        @relation("AtividadeAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  contato      Contact?     @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  conta        Account?     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  oportunidade Opportunity? @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  protocolo    Ticket?      @relation(fields: [protocoloId], references: [id], onDelete: Cascade)

  @@index([contatoId, criadoEm])
  @@index([contaId, criadoEm])
  @@index([oportunidadeId, criadoEm])
  @@index([responsavelId, prazo])
  @@index([prazo])
  @@map("atividades")
}

/// Cada passagem de estagio de uma oportunidade. Alimenta dois relatorios que
/// hoje nao existem: conversao etapa a etapa e tempo medio por etapa.
model OpportunityStageLog {
  id                String   @id @default(uuid())
  oportunidadeId    String   @map("oportunidade_id")
  deEstagioId       String?  @map("de_estagio_id")
  paraEstagioId     String   @map("para_estagio_id")
  usuarioId         String?  @map("usuario_id")
  /// Quanto tempo ficou no estagio de origem. Nulo no primeiro registro.
  segundosNoEstagio Int?     @map("segundos_no_estagio")
  criadoEm          DateTime @default(now()) @map("criado_em")

  oportunidade Opportunity  @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  deEstagio    FunnelStage? @relation("EstagioSaida", fields: [deEstagioId], references: [id], onDelete: SetNull)
  paraEstagio  FunnelStage  @relation("EstagioEntrada", fields: [paraEstagioId], references: [id], onDelete: Cascade)
  usuario      User?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([oportunidadeId, criadoEm])
  @@index([paraEstagioId, criadoEm])
  @@map("oportunidade_historico_estagio")
}

model Product {
  id        String   @id @default(uuid())
  nome      String
  sku       String   @unique
  descricao String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  itensCatalogo     CatalogItem[]
  itensOportunidade OpportunityItem[]

  @@map("produtos")
}

/// Catalogo de precos: mesmo produto pode ter preco diferente por catalogo.
model PriceCatalog {
  id       String   @id @default(uuid())
  nome     String   @unique
  moeda    String   @default("BRL")
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  itens CatalogItem[]

  @@map("catalogos_preco")
}

model CatalogItem {
  id         String  @id @default(uuid())
  catalogoId String  @map("catalogo_id")
  produtoId  String  @map("produto_id")
  preco      Decimal @db.Decimal(14, 2)

  catalogo PriceCatalog @relation(fields: [catalogoId], references: [id], onDelete: Cascade)
  produto  Product      @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([catalogoId, produtoId])
  @@map("catalogo_itens")
}

model OpportunityItem {
  id             String  @id @default(uuid())
  oportunidadeId String  @map("oportunidade_id")
  produtoId      String  @map("produto_id")
  quantidade     Int     @default(1)
  precoUnitario  Decimal @map("preco_unitario") @db.Decimal(14, 2)

  oportunidade Opportunity @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  produto      Product     @relation(fields: [produtoId], references: [id])

  @@unique([oportunidadeId, produtoId])
  @@map("oportunidade_itens")
}

// ---------------------------------------------------------------------------
// Fase 2 — Protocolo / Chamados
// ---------------------------------------------------------------------------

enum TicketStatus {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
  FECHADO
}

enum TicketPrioridade {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

model Ticket {
  /// Numero sequencial legivel, usado na comunicacao com o cliente.
  numero        Int              @unique @default(autoincrement())
  id            String           @id @default(uuid())
  titulo        String
  descricao     String
  status        TicketStatus     @default(ABERTO)
  prioridade    TicketPrioridade @default(NORMAL)
  contatoId     String?          @map("contato_id")
  contaId       String?          @map("conta_id")
  /// Conversa que originou o chamado, quando aberto pelo atendimento.
  conversaId    String?          @map("conversa_id")
  responsavelId String?          @map("responsavel_id")
  filaId        String?          @map("fila_id")
  prazoSla      DateTime?        @map("prazo_sla")
  criadoEm      DateTime         @default(now()) @map("criado_em")
  atualizadoEm  DateTime         @updatedAt @map("atualizado_em")
  resolvidoEm   DateTime?        @map("resolvido_em")
  fechadoEm     DateTime?        @map("fechado_em")

  contato      Contact?           @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  conta        Account?           @relation(fields: [contaId], references: [id], onDelete: SetNull)
  conversa     Conversation?      @relation(fields: [conversaId], references: [id], onDelete: SetNull)
  responsavel  User?              @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  fila         Queue?             @relation(fields: [filaId], references: [id], onDelete: SetNull)
  comentarios  TicketComment[]
  anexos       TicketAttachment[]
  agendamentos TicketSchedule[]
  atividades   Activity[]

  @@index([status, atualizadoEm])
  @@index([responsavelId, status])
  @@map("protocolos")
}

model TicketComment {
  id       String   @id @default(uuid())
  ticketId String   @map("ticket_id")
  autorId  String?  @map("autor_id")
  conteudo String
  /// true = nota interna (nao visivel ao cliente); false = resposta ao cliente.
  interno  Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autor  User?  @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([ticketId, criadoEm])
  @@map("protocolo_comentarios")
}

/// Anexo registrado por URL. O upload direto depende do armazenamento de midia
/// (S3/MinIO), previsto na infra — aqui guardamos apenas os metadados.
model TicketAttachment {
  id       String   @id @default(uuid())
  ticketId String   @map("ticket_id")
  nome     String
  url      String
  tipo     String?
  tamanho  Int?
  autorId  String?  @map("autor_id")
  criadoEm DateTime @default(now()) @map("criado_em")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autor  User?  @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@map("protocolo_anexos")
}

model TicketSchedule {
  id            String    @id @default(uuid())
  ticketId      String    @map("ticket_id")
  titulo        String
  inicio        DateTime
  fim           DateTime?
  responsavelId String?   @map("responsavel_id")
  concluido     Boolean   @default(false)
  criadoEm      DateTime  @default(now()) @map("criado_em")

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  responsavel User?  @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([inicio])
  @@map("protocolo_agendamentos")
}

// ---------------------------------------------------------------------------
// Fase 2 — Canais externos (Meta: WhatsApp, Instagram, Facebook)
// ---------------------------------------------------------------------------

/// Credenciais e destino de fila por canal externo. Um registro por canal.
model ChannelConfig {
  id    String  @id @default(uuid())
  canal Channel @unique
  ativo Boolean @default(false)

  /// WhatsApp Cloud API
  phoneNumberId String? @map("phone_number_id")
  wabaId        String? @map("waba_id")
  /// Instagram Direct / Facebook Messenger
  pageId        String? @map("page_id")
  igUserId      String? @map("ig_user_id")

  /// Token de acesso da Graph API. Nunca retornado pela API (mascarado).
  accessToken String? @map("access_token")
  /// App Secret, usado para validar a assinatura X-Hub-Signature-256.
  appSecret   String? @map("app_secret")
  /// Token do desafio de verificacao do webhook (GET hub.challenge).
  verifyToken String? @map("verify_token")

  /// Fila que recebe as conversas deste canal.
  filaId String? @map("fila_id")

  /// Entrega as mensagens deste canal ao motor de IA externo (ver ia.service).
  iaAtiva      Boolean @default(false) @map("ia_ativa")
  /// Webhook do motor de IA. Ex.: https://whatsbot/api/webhook/plataforma/<id>.
  iaUrlWebhook String? @map("ia_url_webhook")
  /// Segredo HMAC com que assinamos a entrega. Cifrado em repouso.
  iaSegredo    String? @map("ia_segredo")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  fila Queue? @relation(fields: [filaId], references: [id], onDelete: SetNull)

  @@map("canais_config")
}

// ---------------------------------------------------------------------------
// Fase 3 — Gestao, Relatorios, Satisfacao e Escalas
// ---------------------------------------------------------------------------

enum TipoPesquisa {
  CSAT
  NPS
}

/// Pesquisa de satisfacao disparada ao finalizar o atendimento.
model Survey {
  id           String       @id @default(uuid())
  conversaId   String       @unique @map("conversa_id")
  tipo         TipoPesquisa @default(CSAT)
  /// CSAT: 1 a 5. NPS: 0 a 10.
  nota         Int?
  comentario   String?
  /// Token opaco usado no link enviado ao cliente.
  token        String       @unique
  enviadoEm    DateTime     @default(now()) @map("enviado_em")
  /// Preenchido quando o link chega ao cliente. Nulo = criada e nao entregue.
  entregueEm   DateTime?    @map("entregue_em")
  respondidoEm DateTime?    @map("respondido_em")

  conversa Conversation @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([respondidoEm])
  @@map("pesquisas")
}

/// Escala de trabalho do agente: um registro por dia da semana.
model WorkShift {
  id        String   @id @default(uuid())
  agenteId  String   @map("agente_id")
  /// 0 = domingo ... 6 = sabado
  diaSemana Int      @map("dia_semana")
  /// "HH:MM" no fuso da operacao.
  inicio    String
  fim       String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  agente User @relation(fields: [agenteId], references: [id], onDelete: Cascade)

  @@unique([agenteId, diaSemana])
  @@map("escalas")
}

/// Historico de presenca: um intervalo por status. Base das horas trabalhadas.
model PresenceLog {
  id         String      @id @default(uuid())
  usuarioId  String      @map("usuario_id")
  status     AgentStatus
  iniciadoEm DateTime    @default(now()) @map("iniciado_em")
  fim        DateTime?
  /// Duracao em segundos, preenchida ao fechar o intervalo.
  duracao    Int?

  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, iniciadoEm])
  @@index([iniciadoEm])
  @@map("presenca_log")
}

// ---------------------------------------------------------------------------
// Fase 4 — Campanhas e Chatbot
// ---------------------------------------------------------------------------

enum CampanhaStatus {
  RASCUNHO
  ATIVA
  PAUSADA
  CONCLUIDA
}

enum CampanhaItemStatus {
  PENDENTE
  ENVIADO
  FALHOU
  RESPONDIDO
  IGNORADO
}

/// Campanha de contato ativo (envio em massa por canal).
model Campaign {
  id           String         @id @default(uuid())
  nome         String
  canal        Channel        @default(WHATSAPP)
  /// Template da mensagem. Suporta {{nome}}, {{email}} e {{telefone}}.
  mensagem     String
  status       CampanhaStatus @default(RASCUNHO)
  filaId       String?        @map("fila_id")
  criadoPorId  String?        @map("criado_por_id")
  agendadaPara DateTime?      @map("agendada_para")
  iniciadaEm   DateTime?      @map("iniciada_em")
  concluidaEm  DateTime?      @map("concluida_em")
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  fila      Queue?         @relation(fields: [filaId], references: [id], onDelete: SetNull)
  criadoPor User?          @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  itens     CampaignItem[]

  @@index([status])
  @@map("campanhas")
}

model CampaignItem {
  id           String             @id @default(uuid())
  campanhaId   String             @map("campanha_id")
  contatoId    String             @map("contato_id")
  status       CampanhaItemStatus @default(PENDENTE)
  /// Motivo da falha, para o operador corrigir sem abrir log.
  erro         String?
  conversaId   String?            @map("conversa_id")
  enviadoEm    DateTime?          @map("enviado_em")
  respondidoEm DateTime?          @map("respondido_em")

  campanha Campaign @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  contato  Contact  @relation(fields: [contatoId], references: [id], onDelete: Cascade)

  @@unique([campanhaId, contatoId])
  @@index([campanhaId, status])
  @@map("campanha_itens")
}

enum BotAcao {
  RESPONDER
  TRANSFERIR
  ENCERRAR
}

/// Fluxo de atendimento automatico que responde antes do agente assumir.
model Bot {
  id                 String   @id @default(uuid())
  nome               String
  ativo              Boolean  @default(false)
  /// null = vale para todos os canais.
  canal              Channel?
  mensagemBoasVindas String   @map("mensagem_boas_vindas")
  /// Resposta quando nenhum gatilho casa.
  fallback           String
  /// Depois de quantas trocas sem casar nada o bot desiste e deixa na fila.
  limiteSemResposta  Int      @default(2) @map("limite_sem_resposta")
  criadoEm           DateTime @default(now()) @map("criado_em")
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  passos BotStep[]

  @@map("bots")
}

model BotStep {
  id       String   @id @default(uuid())
  botId    String   @map("bot_id")
  ordem    Int
  /// Palavras-chave que ativam o passo (comparadas sem acento e sem caixa).
  gatilhos String[]
  resposta String
  acao     BotAcao  @default(RESPONDER)
  filaId   String?  @map("fila_id")

  bot  Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)
  fila Queue? @relation(fields: [filaId], references: [id], onDelete: SetNull)

  @@unique([botId, ordem])
  @@map("bot_passos")
}

/// Politica de retencao de dados (LGPD). Registro unico, id "default".
model RetentionPolicy {
  id              String    @id @default("default")
  /// Expurgo automatico diario. Desligado por padrao: apagar dado de cliente
  /// e decisao do responsavel, nao efeito colateral de instalar o sistema.
  ativa           Boolean   @default(false)
  diasConversas   Int       @default(90) @map("dias_conversas")
  diasProtocolos  Int       @default(365) @map("dias_protocolos")
  diasPresenca    Int       @default(365) @map("dias_presenca")
  ultimoExpurgoEm DateTime? @map("ultimo_expurgo_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  @@map("politica_retencao")
}

enum AcaoLgpd {
  EXPURGO
  ANONIMIZACAO
  EXPORTACAO
}

/// Trilha de auditoria das operacoes de LGPD — a plataforma tem de conseguir
/// provar o que apagou, quando e a pedido de quem (principio da prestacao de contas).
model LgpdLog {
  id        String   @id @default(uuid())
  acao      AcaoLgpd
  /// Nulo quando a acao foi o expurgo automatico.
  autorId   String?  @map("autor_id")
  /// Sem chave estrangeira de proposito: o registro precisa sobreviver ao
  /// titular que ele documenta.
  contatoId String?  @map("contato_id")
  detalhe   Json
  criadoEm  DateTime @default(now()) @map("criado_em")

  autor User? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@map("lgpd_registros")
}

// ---------------------------------------------------------------------------
// Fase 4 — Voz
// ---------------------------------------------------------------------------

enum CallDirecao {
  ENTRANTE
  SAINTE
}

/// Ciclo de vida da chamada, no vocabulario comum aos provedores SIP.
enum CallStatus {
  INICIANDO
  CHAMANDO
  EM_ANDAMENTO
  COMPLETADA
  NAO_ATENDIDA
  OCUPADA
  FALHOU
  CANCELADA
}

/// Credenciais do provedor de voz. Registro unico, id "default".
model VoiceConfig {
  id              String   @id @default("default")
  ativo           Boolean  @default(false)
  /// Identificador do driver em modules/voice (ex.: "twilio").
  provedor        String   @default("twilio")
  contaSid        String?  @map("conta_sid")
  /// Cifrado em repouso, como os segredos dos canais da Meta.
  authToken       String?  @map("auth_token")
  numeroPadrao    String?  @map("numero_padrao")
  /// URL publica que o provedor chama nos eventos (precisa ser HTTPS).
  urlWebhook      String?  @map("url_webhook")
  /// Fila que recebe as chamadas entrantes.
  filaId          String?  @map("fila_id")
  /// Baixa a gravacao para o storage proprio quando o provedor avisa que existe.
  guardarGravacao Boolean  @default(true) @map("guardar_gravacao")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  fila Queue? @relation(fields: [filaId], references: [id], onDelete: SetNull)

  @@map("voz_config")
}

/// Registro de chamada (CDR). Uma linha por chamada, entrante ou sainte.
model Call {
  id        String      @id @default(uuid())
  /// Id da chamada no provedor. Unico: o webhook reentrega o mesmo evento.
  idExterno String      @unique @map("id_externo")
  direcao   CallDirecao
  status    CallStatus  @default(INICIANDO)

  numeroOrigem  String @map("numero_origem")
  numeroDestino String @map("numero_destino")

  contatoId  String? @map("contato_id")
  conversaId String? @map("conversa_id")
  agenteId   String? @map("agente_id")
  filaId     String? @map("fila_id")

  iniciadoEm  DateTime  @default(now()) @map("iniciado_em")
  atendidoEm  DateTime? @map("atendido_em")
  encerradoEm DateTime? @map("encerrado_em")
  /// Duracao da conversa em segundos, informada pelo provedor no encerramento.
  duracao     Int?

  gravacaoUrl     String?  @map("gravacao_url")
  gravacaoDuracao Int?     @map("gravacao_duracao")
  transcricao     String?
  custo           Decimal? @db.Decimal(10, 4)
  motivoFalha     String?  @map("motivo_falha")

  contato  Contact?      @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  conversa Conversation? @relation(fields: [conversaId], references: [id], onDelete: SetNull)
  agente   User?         @relation(fields: [agenteId], references: [id], onDelete: SetNull)
  fila     Queue?        @relation(fields: [filaId], references: [id], onDelete: SetNull)

  @@index([iniciadoEm])
  @@index([agenteId, iniciadoEm])
  @@index([status])
  @@map("chamadas")
}

// ---------------------------------------------------------------------------
// Fase 4 — Integracoes de maquina (motor de IA externo, ERP, automacoes)
// ---------------------------------------------------------------------------

/// Token de servico para quem chama a API sem ser usuario.
///
/// Nao reaproveita o JWT de usuario de proposito: token de usuario expira em
/// minutos e carrega um perfil com permissao de tela, enquanto integracao
/// precisa de credencial longa, revogavel uma a uma e auditavel sem confundir
/// com gente. Guardado como hash: vazamento do banco nao entrega o token.
model IntegrationToken {
  id      String           @id @default(uuid())
  nome    String
  /// SHA-256 do token. O valor em claro e mostrado uma vez, na criacao.
  hash    String           @unique
  /// Primeiros caracteres, para identificar qual token esta na configuracao.
  prefixo String
  /// Quais rotas o token abre. Hoje so `IA`; enum para nao virar string livre.
  escopo  EscopoIntegracao @default(IA)
  ativo   Boolean          @default(true)

  criadoEm    DateTime  @default(now()) @map("criado_em")
  criadoPorId String?   @map("criado_por_id")
  ultimoUsoEm DateTime? @map("ultimo_uso_em")
  revogadoEm  DateTime? @map("revogado_em")

  criadoPor User? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([ativo])
  @@map("tokens_integracao")
}

enum EscopoIntegracao {
  IA
}
