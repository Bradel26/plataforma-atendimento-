# Porta do servidor HTTP
PORT=3333
NODE_ENV=development

# Banco de dados
# DATABASE_URL: usada pela aplicacao (endpoint pooled em provedores com pgbouncer).
# DIRECT_URL: usada pelo Prisma Migrate, precisa ser conexao direta.
# Com o docker-compose local, aponte as duas para a mesma URL.
DATABASE_URL="postgresql://plataforma:plataforma@localhost:5432/plataforma?schema=public"
DIRECT_URL="postgresql://plataforma:plataforma@localhost:5432/plataforma?schema=public"

# Redis — use rediss:// (TLS) em provedores gerenciados como o Upstash
REDIS_URL="redis://localhost:6379"
# Prefixo de TODA chave no Redis. Separa instalacoes que dividem o mesmo servidor.
# Vazio em producao; "dev" e o padrao em desenvolvimento.
#
# Existe porque o .env local e o de producao apontam para o mesmo Upstash, e a
# fila de trabalho e uma lista unica: sem prefixo, o worker de producao consome
# trabalho criado em desenvolvimento, nao acha o registro no banco dele e volta em
# silencio — o disparo de campanha fica PENDENTE para sempre, sem erro nenhum.
REDIS_PREFIXO=""

# JWT — TROQUE ESTES VALORES EM PRODUCAO
JWT_ACCESS_SECRET="dev-access-secret-troque-em-producao"
JWT_REFRESH_SECRET="dev-refresh-secret-troque-em-producao"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# Origem permitida do frontend (CORS + cookie de refresh)
WEB_ORIGIN="http://localhost:5173"

# Endereco publico desta API, para onde a URL precisa ser absoluta e sair da
# rede: o anexo que o motor de IA externo baixa, por exemplo. Vazio usa
# WEB_ORIGIN, que e o certo quando front e API estao no mesmo dominio.
PUBLIC_URL=""

# Credenciais do usuario admin criado pelo seed
SEED_ADMIN_EMAIL="admin@plataforma.local"
SEED_ADMIN_PASSWORD="Admin@123"

# Arquivos enviados (anexos de protocolo e midia dos canais)
# Driver local: pasta no disco, relativa a apps/api. Para S3/MinIO/R2, ver
# src/lib/storage.ts — as tres funcoes de la sao o unico ponto a trocar.
STORAGE_DIR="./storage"
UPLOAD_MAX_MB=10

# Proxy reverso na frente (Nginx, Caddy, load balancer)? Ligue para o limite por
# IP ver o IP real do cliente em vez do IP do proxy.
TRUST_PROXY=false

# Chave de 32 bytes (hex) para cifrar os segredos dos canais em repouso.
# Gere com: openssl rand -hex 32
# Sem ela, a chave e derivada do JWT_ACCESS_SECRET — serve para desenvolvimento.
# SECRETS_KEY=""
