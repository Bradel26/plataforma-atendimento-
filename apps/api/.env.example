# Porta do servidor HTTP
PORT=3333
NODE_ENV=development

# Banco de dados
# DATABASE_URL: usada pela aplicacao (endpoint pooled em provedores com pgbouncer).
# DIRECT_URL: usada pelo Prisma Migrate, precisa ser conexao direta.
# Com o docker-compose local, aponte as duas para a mesma URL.
DATABASE_URL="postgresql://plataforma:plataforma@localhost:5432/plataforma?schema=public"
DIRECT_URL="postgresql://plataforma:plataforma@localhost:5432/plataforma?schema=public"

# Redis — use rediss:// (TLS) em provedores gerenciados como o Upstash
REDIS_URL="redis://localhost:6379"
# Prefixo de TODA chave no Redis. Separa instalacoes que dividem o mesmo servidor.
# Vazio em producao; "dev" e o padrao em desenvolvimento.
#
# Existe porque o .env local e o de producao apontam para o mesmo Upstash, e a
# fila de trabalho e uma lista unica: sem prefixo, o worker de producao consome
# trabalho criado em desenvolvimento, nao acha o registro no banco dele e volta em
# silencio — o disparo de campanha fica PENDENTE para sempre, sem erro nenhum.
REDIS_PREFIXO=""

# JWT — TROQUE ESTES VALORES EM PRODUCAO
JWT_ACCESS_SECRET="dev-access-secret-troque-em-producao"
JWT_REFRESH_SECRET="dev-refresh-secret-troque-em-producao"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# Origem permitida do frontend (CORS + cookie de refresh)
WEB_ORIGIN="http://localhost:5173"

# Meta Embedded Signup (configuração feita uma vez pelo administrador da plataforma;
# cada usuário autoriza o próprio número pelo fluxo OAuth dentro do sistema).
# META_APP_ID=""
# META_APP_SECRET=""
# META_EMBEDDED_SIGNUP_CONFIG_ID=""
# META_EMBEDDED_SIGNUP_COEX_CONFIG_ID=""
# META_WEBHOOK_VERIFY_TOKEN=""
# Versão fixada do Graph API para onboarding e WhatsApp Calling.
META_GRAPH_API_VERSION="v25.0"
# Transcrição local evita envio de áudio a uma API paga. Em desenvolvimento,
# inicie o serviço com `npm run transcricao:local`; em produção o entrypoint da
# API inicia o Whisper privado automaticamente.
TRANSCRICAO_PROVEDOR="local"
TRANSCRICAO_LOCAL_URL="http://127.0.0.1:3334/v1/audio/transcriptions"
TRANSCRICAO_LOCAL_MODELO="base"
# Opcional: use somente com TRANSCRICAO_PROVEDOR="openai".
# OPENAI_API_KEY=""

# So ligue depois de configurar um dominio proprio com certificado HTTPS.
HSTS_ATIVO=false

# Endereco publico desta API, para onde a URL precisa ser absoluta e sair da
# rede: o anexo que o motor de IA externo baixa, por exemplo. Vazio usa
# WEB_ORIGIN, que e o certo quando front e API estao no mesmo dominio.
PUBLIC_URL=""

# Credenciais do usuario admin criado pelo seed
SEED_ADMIN_EMAIL="admin@plataforma.local"
SEED_ADMIN_PASSWORD="Admin@123"

# Arquivos enviados (anexos de protocolo e midia dos canais)
# Driver local: pasta no disco, relativa a apps/api. Para S3/MinIO/R2, ver
# src/lib/storage.ts — as tres funcoes de la sao o unico ponto a trocar.
STORAGE_DIR="./storage"
UPLOAD_MAX_MB=10

# Proxy reverso na frente (Nginx, Caddy, load balancer)? Ligue para o limite por
# IP ver o IP real do cliente em vez do IP do proxy.
TRUST_PROXY=false

# Chave de 32 bytes (hex) para cifrar os segredos dos canais em repouso.
# Gere com: openssl rand -hex 32
# Sem ela, a chave e derivada do JWT_ACCESS_SECRET — serve para desenvolvimento.
# SECRETS_KEY=""

# Infraestrutura global da Ponte (WhatsApp nao oficial via Baileys, apps/ponte).
# Com as 3 definidas, um usuario comum conecta o proprio WhatsApp em
# Atendimento sem nenhum admin cadastrar linha nenhuma antes — a Ponte vira
# infraestrutura da API, nao configuracao de canal por organizacao. Deixe as
# 3 vazias/ausentes para instalacoes legadas que ainda configuram a ponte
# pela tela Configuracoes > Canais (linha compartilhada); defina so parte
# delas: nunca defina so parte das 3, a API recusa usar config parcial.
# PONTE_URL="http://localhost:3100"
# PONTE_TOKEN=""
# PONTE_SEGREDO=""

# WhatsApp nao oficial: qual driver usar. "baileys" (padrao, apps/ponte),
# "wppconnect" (WPPConnect Server, ver WPPCONNECT.md) ou "waha" (WAHA, ver
# WAHA.md). Vale para a instalacao inteira — linha pessoal e linha
# compartilhada usam o mesmo.
# WHATSAPP_PROVIDER="wppconnect"
# Provider local experimental: usa a MESMA sessão para o QR, mensagens e áudio das chamadas.
# Rode `npm start` em experimentos/whatsapp-webjs-call-poc; não habilite em produção.
# WHATSAPP_PROVIDER="webjs"
# WEBJS_LOCAL_URL="http://127.0.0.1:4174/api/platform"
# WEBJS_LOCAL_TOKEN=""

# WPPConnect Server (so com WHATSAPP_PROVIDER=wppconnect). A URL e a da rede
# interna, sem barra no fim. Autenticacao: WPP_CONNECT_SECRET_KEY (a mesma
# SECRET_KEY do servidor, a API gera um token por sessao) OU WPP_CONNECT_TOKEN
# (token fixo ja gerado). Com as PONTE_* acima vazias, estas bastam para o
# "Conectar WhatsApp" em Atendimento.
# WPP_CONNECT_URL="http://wppconnect:21465"
# WPP_CONNECT_SECRET_KEY=""
# WPP_CONNECT_TOKEN=""
# Segredo que o WPPConnect manda de volta em ?secret= ao postar as mensagens
# recebidas em /api/webhooks/wppconnect. Sem ele nenhuma mensagem entra.
# Gere com: openssl rand -hex 32
# WPP_CONNECT_WEBHOOK_SECRET=""

# WAHA (so com WHATSAPP_PROVIDER=waha). URL da rede interna, sem barra no fim.
# WAHA_API_KEY e a mesma chave configurada no container do WAHA (vai no header
# X-Api-Key). WAHA_WEBHOOK_SECRET autentica o que o WAHA posta em
# /api/webhooks/providers/waha — sem ele a API nao cria sessao, porque ela nunca
# receberia mensagem. Gere as duas com: openssl rand -hex 32
# WAHA_BASE_URL="http://waha:3000"
# WAHA_API_KEY=""
# WAHA_WEBHOOK_SECRET=""
# Opcional: endereco da API que o WAHA chama, quando os dois estao na mesma rede
# interna (ex.: http://plataforma:3333). Sem ela vale PUBLIC_URL (ou WEB_ORIGIN).
# WAHA_WEBHOOK_BASE_URL=""

# Analise comercial: endpoint HTTP interno que aceita o contexto JSON e retorna
# motor, versao, situacao, fatos, entravesProvaveis, perguntas, proximosPassos
# e consumo {unidades,custo}. Custo em reais (BRL), ou null quando ausente.
# Vincule explicitamente a uma organizacao.
# OPORTUNIDADE_IA_ORGANIZACAO_ID=""
# OPORTUNIDADE_IA_URL=""
# OPORTUNIDADE_IA_TOKEN=""
# Alternativa sem token: Ollama em rede privada (tem precedencia sobre URL/TOKEN acima).
# Instale o modelo na VM antes de ativar. Nao exponha a porta 11434 na internet.
# OPORTUNIDADE_IA_OLLAMA_URL="http://127.0.0.1:11434"
# OPORTUNIDADE_IA_OLLAMA_MODELO="qwen3:4b"
# Assistente de consultas CRM; pode reutilizar a mesma instancia Ollama.
# CRM_IA_OLLAMA_URL="http://ollama:11434"
# CRM_IA_OLLAMA_MODELO="qwen3:4b"
# Opcional: analise local de resumo, sentimento e acoes das chamadas (reutiliza Ollama acima se omitido).
# LIGACAO_IA_OLLAMA_URL="http://ollama:11434"
# LIGACAO_IA_OLLAMA_MODELO="qwen3:4b"
