{
  "name": "@plataforma/ponte",
  "private": true,
  "version": "0.1.0",
  "description": "Ponte de WhatsApp nao oficial: mantem a sessao do WhatsApp Web e fala HTTP com a plataforma",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.17.16",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
