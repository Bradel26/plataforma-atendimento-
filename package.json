{
  "name": "plataforma-atendimento",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de Atendimento Multicanal + PABX/Call Center + CRM",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @plataforma/api",
    "dev:web": "npm run dev -w @plataforma/web",
    "build": "npm run build -w @plataforma/api && npm run build -w @plataforma/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "db:migrate": "npm run db:migrate -w @plataforma/api",
    "db:seed": "npm run db:seed -w @plataforma/api",
    "db:studio": "npm run db:studio -w @plataforma/api",
    "setup": "npm install && npm run infra:up && npm run db:migrate && npm run db:seed",
    "smoke": "node scripts/smoke-atendimento.mjs",
    "smoke:canais": "node scripts/smoke-canais.mjs",
    "smoke:pesquisa": "node scripts/smoke-pesquisa.mjs",
    "smoke:midia": "node scripts/smoke-midia.mjs",
    "smoke:seguranca": "node scripts/smoke-seguranca.mjs",
    "smoke:lgpd": "node scripts/smoke-lgpd.mjs",
    "smoke:fila": "node scripts/smoke-fila.mjs",
    "smoke:paginacao": "node scripts/smoke-paginacao.mjs",
    "smoke:widget": "node scripts/smoke-widget.mjs",
    "smoke:voz": "node scripts/smoke-voz.mjs",
    "smoke:metricas": "node scripts/smoke-metricas.mjs",
    "smoke:ficha": "node scripts/smoke-ficha.mjs",
    "smoke:tenant": "node scripts/smoke-tenant.mjs",
    "smoke:tags": "node scripts/smoke-tags.mjs",
    "smoke:visibilidade": "node scripts/smoke-visibilidade.mjs",
    "censo:tenant": "node scripts/censo-tenant.mjs",
    "backup:banco": "node scripts/backup-producao.mjs",
    "validar:producao": "node scripts/validar-producao.mjs",
    "observar:deploy": "node scripts/observar-deploy.mjs",
    "e2e:producao": "playwright test -c playwright.producao.config.ts",
    "smoke:ia": "node scripts/smoke-ia.mjs",
    "gerar:segredos": "node scripts/gerar-segredos.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "worker": "npm run worker -w @plataforma/api",
    "start:worker": "npm run start:worker -w @plataforma/api",
    "smoke:worker": "node scripts/smoke-worker.mjs",
    "lgpd:reaplicar": "npm run lgpd:reaplicar -w @plataforma/api",
    "lgpd:reaplicar:executar": "npm run lgpd:reaplicar:executar -w @plataforma/api",
    "env:coolify": "node scripts/env-para-coolify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^4.1.11"
  }
}
